// The browse page's module, browse.js, type-checked as the browser runs it (mise run types), never
// emitting: the DOM's lib, its catalog typed by catalog.d.ts, which names served.ts's shape.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["browse.js", "catalog.d.ts"]
}
